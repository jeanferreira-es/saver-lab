{
  "expo": {
    "name": "Saver Lab",
    "slug": "igsaver",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.jean.igsaver"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#5B3DF5",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "dev.jean.igsaver",
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sharing",
      "expo-video",
      [
        "expo-media-library",
        {
          "photosPermission": "Permite ver os vídeos salvos.",
          "savePhotosPermission": "Permite salvar os vídeos baixados na galeria.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "expo-secure-store",
      "@preeternal/react-native-cookie-manager",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F6F5F2",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#0F0E13"
          }
        }
      ]
    ],
    "scheme": "igsaver",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "107dd0fb-67bf-44fb-a5f0-06184042a82b"
      }
    },
    "owner": "jeanferreira"
  }
}
